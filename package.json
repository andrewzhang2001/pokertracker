{
  "name": "pokertracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:solver": "node src/reports/pipeline/build-solver.mjs",
    "backfill-preflop": "esbuild src/reports/pipeline/backfill-preflop-spots.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-preflop.mjs && node node_modules/.cache/bf-preflop.mjs",
    "backfill-postflop": "esbuild src/postflop/pipeline/backfill-flop-spots.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-flop.mjs && node node_modules/.cache/bf-flop.mjs",
    "backfill-net": "esbuild src/profiles/pipeline/backfill-hand-net.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-net.mjs && node node_modules/.cache/bf-net.mjs",
    "backfill-reparse": "esbuild db/backfill/hands-reparse.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-reparse.mjs && node node_modules/.cache/bf-reparse.mjs",
    "backfill-recompute": "esbuild db/backfill/hands-recompute.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-recompute.mjs && node node_modules/.cache/bf-recompute.mjs",
    "backfill-owner": "esbuild db/backfill/hands-owner.ts --bundle --platform=node --format=esm --external:@neondatabase/serverless --outfile=node_modules/.cache/bf-owner.mjs && node node_modules/.cache/bf-owner.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.4",
    "@clerk/clerk-react": "^5.61.8",
    "@neondatabase/serverless": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.8"
  }
}
